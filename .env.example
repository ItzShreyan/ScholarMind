# ---------------------------------------------------------------------------
# ScholarMind environment. Copy to `.env.local` and fill in:
#   cp .env.example .env.local
# Never commit `.env.local`. Nothing here is exposed to the browser except the
# two NEXT_PUBLIC_ values, which are safe by design (the anon key is governed by
# row-level security).
# ---------------------------------------------------------------------------

# --- Supabase (required) ---------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — never reference this from client code.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI providers ----------------------------------------------------------
# OpenRouter is the primary provider for chat and every study tool.
OPENROUTER_API_KEY=
# Extra keys are used in order when one hits a rate limit or runs out of credit.
# OPENROUTER_API_KEY_2=
# OPENROUTER_API_KEY_3=

# Gemini is the last-resort fallback provider, and the only one that can still
# answer when every OpenRouter key has failed.
GEMINI_API_KEY=

# Optional. Used only when AI_PRIMARY_PROVIDER points at them.
GROQ_API_KEY=
HUGGINGFACE_API_KEY=
TOGETHER_API_KEY=

# --- Model selection -------------------------------------------------------
# Every id below has a working default in lib/ai/models.ts. Override only if a
# model is retired. Ids must exist on openrouter.ai/models and match the free
# tier — see lib/ai/models.ts for the full fallback chain per tier.
#
# Pro    — heavy reasoning: maths, proofs, code, long structured output.
# OPENROUTER_PRO_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Flash  — fastest good-quality model. The default for everyday questions.
# OPENROUTER_FLASH_MODEL=google/gemma-4-26b-a4b-it:free
# Vision — used automatically when a request carries source images.
# OPENROUTER_VISION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
# Study  — structured-output generation: notes, quizzes, flashcards, exams.
# OPENROUTER_STUDY_MODEL=google/gemma-4-31b-it:free

# Backwards-compatible alias for existing deployments.
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_CHAT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

GEMINI_MODEL=gemini-1.5-flash
GROQ_MODEL=llama-3.1-8b-instant
HUGGINGFACE_MODEL=google/flan-t5-large
TOGETHER_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct-Turbo

# --- Provider preference ---------------------------------------------------
# One of: openrouter | gemini | groq | huggingface | together | local
AI_PRIMARY_PROVIDER=openrouter

# --- Deployment ------------------------------------------------------------
# Set to your production domain. Defaults to https://scholarmindai.netlify.app
# APP_URL=https://scholarmindai.netlify.app
